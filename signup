<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FuneralFriend — Create your account</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --cream: #faf8f4;
    --sky-light: #deeaf5;
    --sky-mid: #b8d4ea;
    --sky-deep: #7aaecf;
    --text-dark: #2c2c2c;
    --text-mid: #5a5a5a;
    --text-light: #8a8a8a;
    --border: #e8e2d9;
    --white: #ffffff;
  }

  body {
    font-family: 'Jost', sans-serif;
    background: linear-gradient(180deg, #c9dff2 0%, #deeaf5 30%, #faf8f4 100%);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
  }

  /* LOGO */
  .logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 26px;
    font-weight: 400;
    color: var(--text-dark);
    text-decoration: none;
    display: block;
    text-align: center;
    margin-bottom: 32px;
  }

  .logo span { color: var(--sky-deep); }

  /* CARD */
  .card {
    background: white;
    border-radius: 24px;
    padding: 48px 40px;
    width: 100%;
    max-width: 440px;
    box-shadow: 0 8px 48px rgba(122,174,207,0.15);
  }

  .card-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    font-weight: 300;
    color: var(--text-dark);
    text-align: center;
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .card-subtitle {
    font-size: 14px;
    font-weight: 300;
    color: var(--text-light);
    text-align: center;
    line-height: 1.7;
    margin-bottom: 32px;
  }

  /* FIELDS */
  .field {
    margin-bottom: 20px;
  }

  .field-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-mid);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 8px;
    display: block;
  }

  .field-input {
    width: 100%;
    padding: 14px 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 15px;
    font-family: 'Jost', sans-serif;
    font-weight: 300;
    color: var(--text-dark);
    background: var(--cream);
    outline: none;
    transition: border-color 0.2s, background 0.2s;
  }

  .field-input:focus {
    border-color: var(--sky-deep);
    background: white;
  }

  /* BUTTON */
  .btn-primary {
    display: block;
    width: 100%;
    background: var(--sky-deep);
    color: white;
    border: none;
    padding: 16px;
    border-radius: 50px;
    font-size: 14px;
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 4px 20px rgba(122,174,207,0.35);
    margin-top: 8px;
    text-decoration: none;
    text-align: center;
  }

  .btn-primary:hover {
    background: #5d9abf;
    transform: translateY(-1px);
    box-shadow: 0 8px 28px rgba(122,174,207,0.4);
  }

  /* PRIVACY NOTE */
  .privacy-note {
    font-size: 11px;
    font-weight: 300;
    color: var(--text-light);
    text-align: center;
    line-height: 1.7;
    margin-top: 16px;
  }

  /* DIVIDER */
  .divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 28px 0;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .divider-text {
    font-size: 12px;
    color: var(--text-light);
    font-weight: 300;
  }

  /* SIGN IN LINK */
  .signin-link {
    text-align: center;
    font-size: 13px;
    font-weight: 300;
    color: var(--text-light);
  }

  .signin-link a {
    color: var(--sky-deep);
    text-decoration: none;
    font-weight: 400;
  }

  .signin-link a:hover {
    text-decoration: underline;
  }

  /* BACK LINK */
  .back-link {
    display: block;
    text-align: center;
    margin-top: 24px;
    font-size: 12px;
    color: var(--text-light);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }

  .back-link:hover { color: var(--sky-deep); }

  @media (max-width: 480px) {
    .card { padding: 36px 24px; }
  }
</style>
</head>
<body>

<a href="index.html" class="logo">Funeral<span>Friend</span></a>

<div class="card">
  <h1 class="card-title">Create your<br>free account</h1>
  <p class="card-subtitle">Your plan will be saved securely.<br>Come back whenever you're ready.</p>

  <div class="field">
    <label class="field-label">First name</label>
    <input type="text" class="field-input" placeholder="e.g. Robert" id="firstname">
  </div>

  <div class="field">
    <label class="field-label">Email address</label>
    <input type="email" class="field-input" placeholder="e.g. your@email.com" id="email">
  </div>

  <div class="field">
    <label class="field-label">Password</label>
    <input type="password" class="field-input" placeholder="At least 8 characters" id="password">
  </div>

  <a href="plan.html" class="btn-primary">Create my account</a>

  <p class="privacy-note">
    We will never send you promotional emails or newsletters.<br>
    You can delete your account at any time.
  </p>

  <div class="divider">
    <div class="divider-line"></div>
    <span class="divider-text">already have an account?</span>
    <div class="divider-line"></div>
  </div>

  <p class="signin-link"><a href="login.html">Sign in here</a></p>
</div>

<a href="index.html" class="back-link">← Back to FuneralFriend</a>

</body>
</html>
